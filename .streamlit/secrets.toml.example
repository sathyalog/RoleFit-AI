# Copy these into Streamlit Community Cloud: App settings -> Secrets.
# Top-level keys are exposed to the app as environment variables.

# APP_MODE: leave unset on Streamlit Cloud -> "public" mode (per-visitor session data,
# nothing written to disk, local-repo features hidden). "owner" is for your own machine.
# APP_MODE = "public"

LLM_PROVIDER = "groq"            # "groq" (free) or "anthropic"
GROQ_API_KEY = "gsk_..."         # free key: https://console.groq.com/keys
# GROQ_MODEL = "llama-3.3-70b-versatile"
# ANTHROPIC_API_KEY = "sk-ant-..."

# Optional integrations (features degrade gracefully when missing)
PINECONE_API_KEY = ""
APIFY_API_TOKEN = ""
GITHUB_PERSONAL_ACCESS_TOKEN = ""

# Turn off LangSmith tracing unless you add a LangSmith key
LANGSMITH_TRACING = "false"
